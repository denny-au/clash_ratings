# Copy this file to ".env" and paste in your own key.
# Get a key at https://developer.clashofclans.com after registering
# an account and creating an API key scoped to your current public IP.
COC_API_KEY=paste_your_key_here

# Optional: change the local port the server runs on
PORT=3000

# Optional: how often (in minutes) the server checks in the background
# whether the tracked clan's current war just ended, so it can save it
# to war history even if nobody has the page open at the time.
POLL_INTERVAL_MINUTES=15

# Optional: only needed when deploying somewhere with a persistent disk
# mounted at a specific path (see DEPLOYMENT.md). Leave unset for local use
# — it defaults to a "data" folder next to server.js. Not used at all if
# GITHUB_TOKEN/GITHUB_REPO below are set (GitHub storage takes over).
# DATA_DIR=/var/data

# Optional: store war history in this GitHub repo instead of a local file —
# see DEPLOYMENT.md's free-hosting path. Needed on hosts with a filesystem
# that doesn't survive restarts (e.g. Render's free tier). Leave both unset
# for local use.
# GITHUB_TOKEN=github_pat_...   (fine-grained token, Contents: read/write, scoped to this one repo)
# GITHUB_REPO=your-username/clash-ratings
# GITHUB_BRANCH=main            (optional, defaults to main)
# GITHUB_DATA_DIR=data          (optional, path inside the repo, defaults to "data")
